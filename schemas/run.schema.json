{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://method-council.dev/schemas/run.schema.json",
  "title": "Run manifest",
  "type": "object",
  "required": [
    "schema_version", "run_id", "created_at", "activity", "rigor", "question_digest",
    "raw_prompt_persisted", "methods", "evidence", "route", "host"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "run_id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{7,127}$" },
    "created_at": { "type": "string", "format": "date-time" },
    "activity": { "enum": ["analyse", "investigate", "decide", "forecast", "architect", "review"] },
    "rigor": { "enum": ["rapid", "standard", "intensive"] },
    "question_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "raw_prompt_persisted": { "const": false },
    "methods": {
      "type": "array", "minItems": 1, "maxItems": 6, "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "digest"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$" },
          "kind": { "enum": ["user-supplied", "repository", "retrieved", "observed", "generated"] },
          "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "locator": { "type": "string" },
          "limitations": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "route": {
      "type": "object",
      "required": [
        "source", "validated", "profile_id", "allow_preview", "challenge_required", "why"
      ],
      "properties": {
        "source": { "enum": ["profile", "model-proposal", "user-explicit"] },
        "validated": { "const": true },
        "profile_id": {
          "type": ["string", "null"],
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "allow_preview": { "type": "boolean" },
        "challenge_required": { "type": "boolean" },
        "why": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "source": { "const": "profile" } } },
          "then": { "properties": { "profile_id": { "type": "string" } } },
          "else": { "properties": { "profile_id": { "const": null } } }
        }
      ]
    },
    "host": {
      "type": "object",
      "required": [
        "adapter", "provider_state", "model_requested", "model_observed",
        "external_api_calls", "correlation_group"
      ],
      "properties": {
        "adapter": { "type": "string", "minLength": 1 },
        "provider_state": { "enum": ["verified", "preview", "unverified", "unavailable", "degraded"] },
        "model_requested": { "type": ["string", "null"] },
        "model_observed": { "type": ["string", "null"] },
        "external_api_calls": { "type": "boolean" },
        "correlation_group": {
          "type": ["string", "null"],
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
