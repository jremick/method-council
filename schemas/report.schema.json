{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://method-council.dev/schemas/report.schema.json",
  "title": "Traceable report",
  "type": "object",
  "required": [
    "schema_version", "run_id", "status", "side_conditions", "judgment",
    "decision_boundary", "next_action", "key_judgments", "strongest_alternative",
    "assumptions", "unknowns", "dissent", "checkpoint", "method_ledger", "limitations"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "run_id": { "type": "string" },
    "status": { "enum": ["PASS", "FAIL", "ERROR", "INCOMPLETE"] },
    "side_conditions": {
      "type": "array", "uniqueItems": true,
      "items": { "enum": ["DEGRADED", "CORRELATED", "SKIPPED"] }
    },
    "judgment": { "type": "string", "minLength": 1 },
    "decision_boundary": { "type": "string", "minLength": 1 },
    "next_action": { "type": "string", "minLength": 1 },
    "key_judgments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["statement", "finding_refs", "confidence"],
        "properties": {
          "statement": { "type": "string" },
          "finding_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
          "confidence": { "enum": ["low", "moderate", "high", "not-assessed"] },
          "confidence_basis": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "strongest_alternative": { "type": "string" },
    "assumptions": { "type": "array", "items": { "type": "string" } },
    "unknowns": { "type": "array", "items": { "type": "string" } },
    "dissent": { "type": "array", "items": { "type": "string" } },
    "checkpoint": {
      "type": "object",
      "required": ["trigger", "indicators"],
      "properties": {
        "trigger": { "type": "string" },
        "indicators": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "method_ledger": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["method_id", "status", "result_digest"],
        "properties": {
          "method_id": { "type": "string" },
          "status": { "enum": ["PASS", "FAIL", "ERROR", "INCOMPLETE"] },
          "result_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
        },
        "additionalProperties": false
      }
    },
    "limitations": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  },
  "additionalProperties": false
}
